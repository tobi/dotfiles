#!/usr/bin/env bash
# Best-effort xdg-open shim. It always returns success after either opening the
# target or printing an actionable fallback.

set -u

is_graphical_local_session() {
  local session_type="${XDG_SESSION_TYPE:-}"

  [[ -z "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]] || return 1

  case "$session_type" in
    wayland) [[ -n "${WAYLAND_DISPLAY:-}" ]] ;;
    x11) [[ -n "${DISPLAY:-}" ]] ;;
    tty) return 1 ;;
    *) [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] ;;
  esac
}

is_url_like() {
  [[ $# -gt 0 ]] || return 1
  case "$1" in
    http://*|https://*|ftp://*|mailto:*) return 0 ;;
    file://*) return 1 ;;
    *) [[ ! -e "$1" ]] ;;
  esac
}

try_open() {
  if [[ "$(uname -s 2>/dev/null || true)" == "Darwin" ]] &&
    [[ -x /usr/bin/open ]]; then
    /usr/bin/open "$@" >/dev/null 2>&1 && return 0
  fi

  if is_graphical_local_session && [[ -x /usr/bin/xdg-open ]]; then
    /usr/bin/xdg-open "$@" >/dev/null 2>&1 && return 0
  fi

  return 1
}

print_fallback() {
  local target="$*"
  local real_user tty quoted_target
  local osc8_start osc8_end msg

  if [[ -z "$target" ]]; then
    printf '%s\n' 'xdg-open: no target supplied' >&2 || true
    return 0
  fi

  real_user="${SUDO_USER:-${USER:-$(id -un 2>/dev/null || true)}}"
  tty=""
  if [[ -n "$real_user" ]] && command -v who >/dev/null 2>&1 &&
    command -v awk >/dev/null 2>&1; then
    tty="$(who 2>/dev/null | awk -v u="$real_user" \
      '$1 == u { print "/dev/" $2; exit }' 2>/dev/null || true)"
  fi

  printf -v quoted_target "%q" "$target"
  osc8_start=$'\e]8;;'"$target"$'\e\\'
  osc8_end=$'\e]8;;\e\\'

  msg=$'\n'
  msg+=$'\e[1;33m=== xdg-open fallback ===\e[0m\n'
  msg+=$'\n'
  msg+=$'\e[1mOpen this target in your browser or file manager:\e[0m\n'
  msg+=$'\n'
  msg+="  ${osc8_start}${target}${osc8_end}"$'\n'
  msg+=$'\n'
  msg+=$'\e[2m(clickable in terminals that support OSC 8 hyperlinks)\e[0m\n'
  msg+=$'\n'
  if is_url_like "$@"; then
    msg+=$'\e[1;36m=== From a local machine through the SSH proxy ===\e[0m\n'
    msg+=$'\n'
    msg+="chrome-ssh host -- ${quoted_target}"$'\n'
    msg+=$'\n'
  fi
  msg+=$'\e[1;33m========================\e[0m\n'

  if [[ -n "$tty" && -w "$tty" ]] &&
    printf '%s' "$msg" >"$tty" 2>/dev/null; then
    :
  else
    printf '%s' "$msg" >&2 2>/dev/null || true
  fi
  return 0
}

if [[ $# -gt 0 ]] && try_open "$@"; then
  exit 0
fi

print_fallback "$@"
exit 0
