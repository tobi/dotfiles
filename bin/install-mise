#!/usr/bin/env bash
set -euo pipefail

# Install mise without requiring a distro-specific package.
if command -v mise >/dev/null 2>&1; then
  mise_bin=$(command -v mise)
elif [[ -x "$HOME/.local/bin/mise" ]]; then
  mise_bin="$HOME/.local/bin/mise"
else
  command -v curl >/dev/null 2>&1 || {
    printf 'curl is required to install mise\n' >&2
    exit 1
  }
  curl https://mise.run | sh
  mise_bin="$HOME/.local/bin/mise"
fi

if [[ ! -x "$mise_bin" ]] && ! command -v mise >/dev/null 2>&1; then
  printf 'mise installation did not produce an executable\n' >&2
  exit 1
fi

# Prefer prebuilt Ruby binaries instead of compiling Ruby locally.
"$mise_bin" settings set ruby.compile false

# Use mise-managed runtimes globally. `mise use` is idempotent and records the
# choices in ~/.config/mise/config.toml.
"$mise_bin" use --global \
  age@latest ast-grep@latest btop@latest bun@latest duckdb@latest dust@latest \
  eza@latest envsubst@latest fastfetch@latest fd@latest ffmpeg@latest fzf@latest \
  gh@latest git-lfs@latest gitleaks@latest glow@latest gum@latest hyperfine@latest jq@latest \
  lazygit@latest node@lts pnpm@latest rclone@latest rg@latest ruby@latest \
  shellcheck@latest sqlite@latest tmux@latest tokei@latest uv@latest yazi@latest \
  zoxide@latest
"$mise_bin" install

printf '\nmise is installed. Start a new shell (or run: eval "$(mise activate bash)")\n'
