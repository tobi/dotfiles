#!/usr/bin/env bash
set -euo pipefail

DOTFILES_PATH="${DOTFILES_PATH:-$HOME/.local/share/dotfiles}"
cd "$HOME" # Ignore project-local mise.toml files during global reconciliation.

update=0
if [[ "${1:-}" == "-u" || "${1:-}" == "--update" ]]; then
  update=1
fi

# Install mise without requiring a distro-specific package. Tools themselves
# are installed lazily by bin/shims on first use.
if command -v mise >/dev/null 2>&1; then
  mise_bin=$(command -v mise)
elif [[ -x "$HOME/.local/bin/mise" ]]; then
  mise_bin="$HOME/.local/bin/mise"
else
  command -v curl >/dev/null 2>&1 || {
    printf 'curl is required to install mise\n' >&2
    exit 1
  }
  curl https://mise.run | sh
  mise_bin="$HOME/.local/bin/mise"
fi

if [[ ! -x "$mise_bin" ]] && ! command -v mise >/dev/null 2>&1; then
  printf 'mise installation did not produce an executable\n' >&2
  exit 1
fi

if [[ "$update" == 1 ]]; then
  "$mise_bin" self-update --yes || echo "* mise self-update unavailable; continuing"
  mise_bin=$(command -v mise 2>/dev/null || printf '%s' "$mise_bin")
fi

# Everyday tools stay on exact pins so `mise x` never resolves `latest`.
# Agent CLIs are the exception: they opt into mise auto_update below.
# Everything else still updates through `apply -u`.
"$mise_bin" settings set pin true
"$mise_bin" settings set github.use_git_credentials true

# Avoid brand-new releases until they have had a week of exposure. Our own
# rapidly iterated tools are exempt from the age gate.
"$mise_bin" settings set minimum_release_age 7d
"$mise_bin" settings set minimum_release_age_excludes \
  'github:tobi/s,gem:try-cli'

# Require prebuilt Ruby binaries instead of falling back to local compilation.
"$mise_bin" settings set ruby.compile false
"$mise_bin" settings set ruby.precompiled_url \
  'https://github.com/jdx/ruby/releases/download/{version}/ruby-{version}.{platform}.tar.gz'

# Agent CLIs from bin/shims. Exact pins are never auto-updated, so these
# stay on `latest` and check for a newer build every four hours.
MISE_CLANKERS=(pi codex opencode oh-my-pi)

mise_tools_key() {
  case "$1" in
    *[!A-Za-z0-9_-]*) printf 'tools."%s"' "$1" ;;
    *) printf 'tools.%s' "$1" ;;
  esac
}

mise_is_clanker() {
  local t
  for t in "${MISE_CLANKERS[@]}" github:can1357/oh-my-pi; do
    [[ "$1" == "$t" ]] && return 0
  done
  return 1
}

enable_clanker_auto_update() {
  local tool
  for tool in "${MISE_CLANKERS[@]}"; do
    "$mise_bin" config get -g "$(mise_tools_key "$tool")" >/dev/null 2>&1 || continue
    "$mise_bin" config set -g "$(mise_tools_key "$tool").version" latest
    "$mise_bin" config set -g "$(mise_tools_key "$tool").auto_update" 4h
    "$mise_bin" config set -g "$(mise_tools_key "$tool").minimum_release_age" 0s
  done
}

# Migrate old fuzzy global entries (latest/lts) to their currently installed
# versions without upgrading them. Once pinned, subsequent applies are no-ops.
# Only rewrite tools already in the user config so system lists (Omarchy) are
# not copied in as pins. Skip agent CLIs so this does not undo auto_update.
while read -r tool version _ requested _; do
  [[ -n "$tool" && -n "$version" ]] || continue
  [[ "$requested" != "$version" ]] || continue
  if mise_is_clanker "$tool"; then
    continue
  fi
  "$mise_bin" config get -g "$(mise_tools_key "$tool")" >/dev/null 2>&1 || continue
  "$mise_bin" use -g --pin "$tool@$version"
done < <("$mise_bin" ls --global --installed --no-header 2>/dev/null || true)

# Retire the old registry mapping; Herdr now installs from herdrdev/herdr via
# its standalone shim. Keep the already-downloaded binary for cache reuse.
"$mise_bin" unuse -g --no-prune herdr >/dev/null 2>&1 || true
# omp comes from the oh-my-pi registry shortname, not this raw github backend.
"$mise_bin" unuse -g --no-prune github:can1357/oh-my-pi >/dev/null 2>&1 || true

# Starship is the one eager mise tool because shell startup consumes it.
if ! "$mise_bin" where starship >/dev/null 2>&1; then
  "$mise_bin" use -g --pin starship@latest
fi

# Omarchy may have generated equivalent mise wrappers in ~/.local/bin. Remove
# only that exact generated pattern so the non-updating dotfiles shims can win;
# independently installed commands remain untouched.
for shim in "$DOTFILES_PATH/bin/shims"/*; do
  command=$(basename "$shim")
  wrapper="$HOME/.local/bin/$command"
  [[ -f "$wrapper" ]] || continue
  wrapper_head=$(head -n 8 "$wrapper" 2>/dev/null || true)
  if [[ "$wrapper_head" == *"mise use -g"* && "$wrapper_head" == *"exec mise x"* ]]; then
    rm -f "$wrapper"
  fi
done

if [[ "$update" == 1 ]]; then
  # Lazy shims add exact global pins on first use. Update only those existing
  # pins; preserve Node's LTS channel and Ruby's intentional fixed version.
  "$mise_bin" upgrade --bump --exclude node --exclude ruby
  if "$mise_bin" where node >/dev/null 2>&1; then
    "$mise_bin" use -g --pin node@lts
  fi

  # Bun-backed CLI shims use Bun's global package store.
  if bun_dir=$("$mise_bin" where bun 2>/dev/null); then
    bun="$bun_dir/bin/bun"
    if [[ -n "${BUN_INSTALL:-}" ]]; then
      bun_home="$BUN_INSTALL"
    elif [[ -n "${XDG_CACHE_HOME:-}" ]]; then
      bun_home="$XDG_CACHE_HOME/.bun"
    else
      bun_home="$HOME/.bun"
    fi
    if [[ -f "$bun_home/install/global/package.json" ]]; then
      "$bun" update --global --latest
    fi
  fi
fi

# After pin migration and `upgrade --bump`, put agent CLIs back on latest so
# mise auto_update can move them. No-op for tools nobody has installed yet.
enable_clanker_auto_update
