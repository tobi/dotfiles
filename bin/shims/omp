#!/bin/bash
set -e

if ! mise where bun >/dev/null 2>&1; then
  mise use -g --pin "bun@latest" || exit 1
fi
bun="$(mise where bun)/bin/bun"
if [[ -n "${BUN_INSTALL:-}" ]]; then
  bun_home="$BUN_INSTALL"
elif [[ -n "${XDG_CACHE_HOME:-}" ]]; then
  bun_home="$XDG_CACHE_HOME/.bun"
else
  bun_home="$HOME/.bun"
fi
bin="$bun_home/bin/omp"
if [[ ! -x "$bin" ]]; then
  "$bun" add --global "@oh-my-pi/pi-coding-agent@latest" || exit 1
fi
exec mise x bun -- "$bin" "$@"
