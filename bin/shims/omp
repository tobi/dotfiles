#!/bin/bash
set -e

tool="oh-my-pi"
if ! mise where "$tool" >/dev/null 2>&1; then
  mise use -g --pin "$tool@latest" || exit 1
  mise config set -g "tools.${tool}.version" latest
  mise config set -g "tools.${tool}.auto_update" 4h
  mise config set -g "tools.${tool}.minimum_release_age" 0s
fi
exec mise x "$tool" -- "omp" "$@"
