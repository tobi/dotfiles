#!/bin/bash
set -e

if ! mise where bun >/dev/null 2>&1; then
  MISE_MINIMUM_RELEASE_AGE=0 mise use -g --pin "bun@latest" || exit 1
fi
bun="$(mise where bun)/bin/bun"
if [[ -n "${BUN_INSTALL:-}" ]]; then
  bun_home="$BUN_INSTALL"
elif [[ -n "${XDG_CACHE_HOME:-}" ]]; then
  bun_home="$XDG_CACHE_HOME/.bun"
else
  bun_home="$HOME/.bun"
fi
bin="$bun_home/bin/playwright"
if [[ ! -x "$bin" ]]; then
  MISE_MINIMUM_RELEASE_AGE=0 "$bun" add --global "playwright@latest" || exit 1
fi
exec mise x bun -- "$bin" "$@"
