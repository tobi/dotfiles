#!/bin/bash
set -e

if ! ruby_version=$(mise latest --installed "ruby@4.0.6" 2>/dev/null); then
  MISE_MINIMUM_RELEASE_AGE=0 mise use -g "ruby@4.0.6" || exit 1
  ruby_version=$(mise latest --installed "ruby@4.0.6")
fi
if ! try_version=$(mise latest --installed "gem:try-cli@latest" 2>/dev/null); then
  MISE_MINIMUM_RELEASE_AGE=0 mise use -g "gem:try-cli@latest" || exit 1
  try_version=$(mise latest --installed "gem:try-cli@latest")
fi
exec mise x "ruby@$ruby_version" "gem:try-cli@$try_version" -- try "$@"
