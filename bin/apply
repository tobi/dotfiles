#!/usr/bin/env bash
set -euo pipefail

export DOTFILES_PATH="$HOME/.local/share/dotfiles"
export PATH="$HOME/.local/bin:$PATH"
[[ ! -d /opt/homebrew/bin ]] || export PATH="/opt/homebrew/bin:$PATH"

update_tools=0
skip_pull=0
for arg in "$@"; do
  case "$arg" in
    -u|--update) update_tools=1 ;;
    --skip-pull) skip_pull=1 ;;
    *) echo "usage: apply [-u|--update] [--skip-pull]" >&2; exit 2 ;;
  esac
done

if [[ "$skip_pull" == 0 ]]; then
  echo "updating dotfiles..."
  git -C "$DOTFILES_PATH" pull --rebase
  args=(--skip-pull)
  [[ "$update_tools" == 0 ]] || args+=(-u)
  exec "$DOTFILES_PATH/bin/apply" "${args[@]}"
fi

run_as_root() {
  if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    echo "sudo is required to update system packages" >&2
    return 1
  fi
}

echo "installing mise..."
if [[ "$update_tools" == 1 ]]; then
  "$DOTFILES_PATH/bin/install-mise" -u
else
  "$DOTFILES_PATH/bin/install-mise"
fi

# Load the declarative native package list after mise so portable tools are not
# redundantly requested from the system package manager.
source "$DOTFILES_PATH/src/std.sh"
source "$DOTFILES_PATH/src/packages.sh"

echo "updating system packages..."
case "$VENDOR" in
  ubuntu|debian)
    run_as_root apt-get update
    run_as_root apt-get upgrade -y
    if [[ ${#missing_apt_package[@]} -gt 0 ]]; then
      run_as_root apt-get install -y "${missing_apt_package[@]}"
    fi
    ;;
  arch)
    run_as_root pacman -Syu --needed --noconfirm "${missing_pacman_package[@]}"
    ;;
  apple)
    brew update
    brew upgrade
    if [[ ${#missing_brew_package[@]} -gt 0 ]]; then
      brew install "${missing_brew_package[@]}"
    fi
    ;;
  *)
    echo "* system package updates unsupported for vendor: $VENDOR"
    ;;
esac

echo "configuring git..."
bash "$DOTFILES_PATH/src/git.sh"

echo "linking configuration..."
mkdir -p "$HOME/.config"
ln -nfs "$DOTFILES_PATH/config/_config.starship_toml" "$HOME/.config/starship.toml"
bash "$DOTFILES_PATH/src/ghostty.sh"

echo "installing shell entrypoints..."
# Keep each user rc file organized around a small generated block. Anything
# outside that block is user configuration and can be moved to the per-shell
# .local file after the user has seen it.
ensure_shell_rc() {
  local name="$1"    # e.g. zshrc, bashrc
  local rc="$HOME/.$name"
  local local_rc="$HOME/.$name.local"
  local source_line="source \"$DOTFILES_PATH/shell\""
  local local_line="[ -f \"$local_rc\" ] && source \"$local_rc\""
  local local_line_home="[ -f \"\$HOME/.$name.local\" ] && source \"\$HOME/.$name.local\""
  local marker="# End of automatically generated configuration"
  local gunk_file gunk_lines answer tmp

  # Migrate the legacy .bashrc -> .zshrc symlink to an independent file.
  [[ ! -L "$rc" ]] || rm "$rc"

  gunk_file="$(mktemp)"
  if [[ -f "$rc" ]]; then
    awk -v source_line="$source_line" -v local_line="$local_line" \
      -v local_line_home="$local_line_home" -v marker="$marker" '
      $0 == "# Dotfiles" || $0 == source_line ||
      $0 == "# Local overrides, sourced after dotfiles so they win" ||
      $0 == local_line || $0 == local_line_home || $0 == marker || NF == 0 { next }
      { print }
    ' "$rc" >"$gunk_file"
  fi

  gunk_lines="$(wc -l <"$gunk_file")"
  if ((gunk_lines > 0)); then
    echo
    echo "* There are $gunk_lines lines of gunk in $rc:"
    echo "---"
    while IFS= read -r line; do
      printf '%s\n' "$line"
    done <"$gunk_file"
    echo "---"

    answer=""
    if [[ -t 0 ]]; then
      printf 'Append this gunk to %s? [y/N] ' "$local_rc" >&2
      read -r answer || answer=""
    else
      echo "* No interactive terminal; leaving them in $rc."
    fi

    if [[ "$answer" =~ ^[Yy]$ ]]; then
      if [[ -s "$local_rc" ]]; then
        printf '\n' >>"$local_rc"
      fi
      while IFS= read -r line; do
        printf '%s\n' "$line"
      done <"$gunk_file" >>"$local_rc"
      : >"$gunk_file"
      echo "* Appended to $local_rc."
    fi
  fi

  tmp="$(mktemp)"
  {
    echo "# Dotfiles"
    echo "$source_line"
    echo
    echo "# Local overrides, sourced after dotfiles so they win"
    echo "$local_line"
    echo "$marker"
  } >"$tmp"

  if ((gunk_lines > 0)) && [[ -s "$gunk_file" ]]; then
    # The user declined: preserve the lines, but keep the generated block
    # authoritative and easy to find.
    {
      while IFS= read -r line; do
        printf '%s\n' "$line"
      done <"$gunk_file"
      cat "$tmp"
    } >"$rc"
    rm "$tmp"
  else
    mv "$tmp" "$rc"
  fi

  chmod u+rw "$rc"
  rm -f "$gunk_file"
}

ensure_shell_rc zshrc
ensure_shell_rc bashrc

echo
echo "dotfiles applied"
