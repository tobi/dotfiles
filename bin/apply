#!/usr/bin/env bash
set -euo pipefail

export DOTFILES_PATH="$HOME/.local/share/dotfiles"
export PATH="$HOME/.local/bin:$PATH"
[[ ! -d /opt/homebrew/bin ]] || export PATH="/opt/homebrew/bin:$PATH"

update_tools=0
skip_pull=0
for arg in "$@"; do
  case "$arg" in
    -u|--update) update_tools=1 ;;
    --skip-pull) skip_pull=1 ;;
    *) echo "usage: apply [-u|--update] [--skip-pull]" >&2; exit 2 ;;
  esac
done

if [[ "$skip_pull" == 0 ]]; then
  echo "updating dotfiles..."
  git -C "$DOTFILES_PATH" pull --rebase
  args=(--skip-pull)
  [[ "$update_tools" == 0 ]] || args+=(-u)
  exec "$DOTFILES_PATH/bin/apply" "${args[@]}"
fi

run_as_root() {
  if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    echo "sudo is required to update system packages" >&2
    return 1
  fi
}

echo "installing mise..."
if [[ "$update_tools" == 1 ]]; then
  "$DOTFILES_PATH/bin/install-mise" -u
else
  "$DOTFILES_PATH/bin/install-mise"
fi

# Load the declarative native package list after mise so portable tools are not
# redundantly requested from the system package manager.
source "$DOTFILES_PATH/src/std.sh"
source "$DOTFILES_PATH/src/packages.sh"

echo "updating system packages..."
case "$VENDOR" in
  ubuntu|debian)
    run_as_root apt-get update
    run_as_root apt-get upgrade -y
    if [[ ${#missing_apt_package[@]} -gt 0 ]]; then
      run_as_root apt-get install -y "${missing_apt_package[@]}"
    fi
    ;;
  arch)
    run_as_root pacman -Syu --needed --noconfirm "${missing_pacman_package[@]}"
    ;;
  apple)
    brew update
    brew upgrade
    if [[ ${#missing_brew_package[@]} -gt 0 ]]; then
      brew install "${missing_brew_package[@]}"
    fi
    ;;
  *)
    echo "* system package updates unsupported for vendor: $VENDOR"
    ;;
esac

echo "configuring git..."
bash "$DOTFILES_PATH/src/git.sh"

echo "linking configuration..."
mkdir -p "$HOME/.config"
ln -nfs "$DOTFILES_PATH/config/_config.starship_toml" "$HOME/.config/starship.toml"

echo "installing shell entrypoints..."
# Keep each user rc file intact: only ensure the dotfiles source line and the
# per-shell local override line are present. The local file is sourced last so
# it wins, but only when it exists. Never rewrite user content.
ensure_shell_rc() {
  local name="$1"    # e.g. zshrc, bashrc
  local rc="$HOME/.$name"
  local local_rc="$HOME/.$name.local"
  local source_line="source \"$DOTFILES_PATH/shell\""
  local local_line="[ -f \"$local_rc\" ] && source \"$local_rc\""

  # Migrate the legacy .bashrc -> .zshrc symlink to an independent file.
  [[ ! -L "$rc" ]] || rm "$rc"

  if [[ ! -f "$rc" ]]; then
    {
      echo "# Dotfiles"
      echo "$source_line"
      echo
      echo "# Local overrides, sourced after dotfiles so they win"
      echo "$local_line"
    } >"$rc"
    return 0
  fi

  local has_source=0 has_local=0
  grep -qF "$source_line" "$rc" && has_source=1
  grep -qF "$local_line" "$rc" && has_local=1

  if [[ "$has_source" == 0 ]]; then
    if [[ "$has_local" == 1 ]]; then
      # Local must stay last: insert the dotfiles block just before it.
      local tmp
      tmp="$(mktemp)"
      awk -v source_line="$source_line" -v local_line="$local_line" '
        $0 == local_line {
          print "# Dotfiles"
          print source_line
          print ""
          print "# Local overrides, sourced after dotfiles so they win"
          print local_line
          next
        }
        { print }
      ' "$rc" >"$tmp"
      mv "$tmp" "$rc"
    else
      {
        echo
        echo "# Dotfiles"
        echo "$source_line"
        echo
        echo "# Local overrides, sourced after dotfiles so they win"
        echo "$local_line"
      } >>"$rc"
    fi
    return 0
  fi

  # Dotfiles line already present; add the local override after it if missing.
  [[ "$has_local" == 1 ]] || echo "$local_line" >>"$rc"
}

ensure_shell_rc zshrc
ensure_shell_rc bashrc

echo
echo "dotfiles applied"
