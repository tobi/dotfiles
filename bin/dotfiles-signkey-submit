#!/usr/bin/env bash
set -euo pipefail

key="${1:-$HOME/.ssh/id_ed25519.pub}"
url="https://github.com/settings/ssh/new"

[[ -f "$key" ]] || { echo "no public signing key found at $key" >&2; exit 1; }

cat "$key"
printf '\n'

# OSC 8 makes the visible URL clickable in supporting terminals.
printf '\033]8;;%s\033\\%s\033]8;;\033\\\n' "$url" "$url"
