# Shared terminal behavior. Machine-specific appearance and bindings live in
# ~/.config/ghostty/local.conf, loaded after this file so local choices win.
shell-integration-features = true
confirm-close-surface = true
mouse-hide-while-typing = true

# Keep the default clipboard read prompt and unsafe-paste protection.

# Clipboard bindings and distinct modified Enter keys for terminal applications.
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = shift+enter=csi:13;2u
keybind = alt+shift+enter=csi:13;4u

config-file = ?"~/.config/ghostty/local.conf"
