export EDITOR=nano
export DOTFILES_PATH="$HOME/.local/share/dotfiles"

# Global environment variables (ported from dotnix home.nix)
export DO_NOT_TRACK="1"
export OLLAMA_HOST="https://ollama.tail250b8.ts.net"
export SKILLS_DIR="$HOME/.agents/skills"
alias ls='ls --color'
alias ll='ls -lh'
alias la='ls -ah'
alias lla='ls -lah'
alias ..='cd ..'

alias e='$EDITOR'

# Aliases ported from dotnix home.nix / shell.nix
alias gs="git status"
alias sg="ast-grep"
alias t="try"
alias c="pbcopy"
alias v="pbpaste"

# Prepend deliberate user/tool paths without rebuilding the OS-provided PATH.
add_path() {
  [[ -d "$1" ]] || return 0
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1:$PATH" ;;
  esac
}

path_first() {
  local dir="$1" padded_path
  [[ -d "$dir" ]] || return 0
  padded_path=":$PATH:"
  padded_path=${padded_path//":$dir:"/:}
  padded_path=${padded_path#:}
  padded_path=${padded_path%:}
  PATH="$dir${padded_path:+:$padded_path}"
}

# Listed from lowest to highest priority because each entry is prepended.
add_path "/opt/homebrew/bin"
add_path "${HOME}/.cargo/bin"
add_path "${HOME}/.bin"
add_path "${HOME}/bin"
add_path "${DOTFILES_PATH}/bin"
add_path "${HOME}/.local/bin"
export PATH

# SSH runs Bash startup files for remote commands such as rsync. Keep those
# sessions silent so shell setup output cannot corrupt command protocols.
[[ $- != *i* ]] && return 0

dotfiles-update() {
  command apply "$@"
}

if [[ -n "${ZSH_VERSION:-}" ]]; then
  export SHELL_ENV=zsh
else
  export SHELL_ENV=bash
fi

# One-time: register this machine's SSH key as a GitHub *signing* key and lock
# the dotfiles repo to signed commits. Run it once per machine after the key
# exists; it is otherwise a no-op. Requires the interactive gh OAuth refresh
# (admin:ssh_signing_key scope) which is why it lives behind a function and
# not in apply.
dotfiles-signing-enable() {
  local key="$HOME/.ssh/id_ed25519.pub"
  [[ -f "$key" ]] || { echo "no $key found" >&2; return 1; }
  command -v gh >/dev/null 2>&1 || { echo "gh not installed" >&2; return 1; }

  # Ensure the token can manage signing keys (interactive browser/device flow).
  gh auth refresh -h github.com -s admin:ssh_signing_key || return $?

  # Upload as a signing key if not already present (GitHub dedupes by content
  # but re-adding returns a conflict, so guard on a title match).
  local pub title="dotfiles signing $(hostname -s)"
  pub=$(cat "$key")
  if ! gh api user/ssh_signing_keys --jq '.[].key' 2>/dev/null | grep -qF "$pub"; then
    gh ssh-key add --type signing "$key" --title "$title" || return $?
    echo "uploaded signing key: $title"
  else
    echo "signing key already on GitHub"
  fi

  # Require signed commits on dotfiles main (owner-only branch protection).
  gh api -X POST repos/tobi/dotfiles/branches/main/protection/required_signatures \
    >/dev/null 2>&1 && echo "dotfiles main now requires signed commits" ||
    echo "could not enable required_signatures (need repo admin)"
}

source "$DOTFILES_PATH/src/std.sh"
source "$DOTFILES_PATH/src/mise.sh"

load_local_overrides() {
  [[ -f "$HOME/.${SHELL_ENV}rc.local" ]] && source "$HOME/.${SHELL_ENV}rc.local"
}

# Keep dumb terminals limited to paths, Mise, and safe deletion.
if command_present "trash-put"; then
  alias rm="trash-put"
else
  require_apply_tool "trash-put"
fi
if [[ "${TERM:-}" == dumb ]]; then
  load_local_overrides
  return 0
fi

source "$DOTFILES_PATH/src/history.sh"
source "$DOTFILES_PATH/src/tools.sh"

[[ "$VENDOR" != "apple" ]] || source "$DOTFILES_PATH/src/vendor.apple.sh"

# See if we need some local overrides (.zshrc.local, .bashrc.local)
load_local_overrides

# Mise shims win even when local overrides prepend other toolchains.
path_first "$HOME/.local/share/mise/shims"
export PATH

if [[ "$DOTFILES_APPLY_NEEDED" == 1 ]]; then
  printf "* run '\033[38;2;0;180;180mapply\033[0m' for new packages\n"
fi

# Return true to indicate successful sourcing of the file
return 0
