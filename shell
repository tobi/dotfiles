export EDITOR=nano
export DOTFILES_PATH="$HOME/.local/share/dotfiles"

# Global environment variables (ported from dotnix home.nix)
export DO_NOT_TRACK="1"
export OLLAMA_HOST="https://ollama.tail250b8.ts.net"
export SKILLS_DIR="$HOME/.agents/skills"
alias ls='ls --color'
alias ll='ls -lh'
alias la='ls -ah'
alias lla='ls -lah'
alias ..='cd ..'

alias e='$EDITOR'

# Aliases ported from dotnix home.nix / shell.nix
alias gs="git status"
alias sg="ast-grep"
alias t="try"
alias c="pbcopy"
alias v="pbpaste"

# Prepend deliberate user/tool paths without rebuilding the OS-provided PATH.
add_path() {
  [[ -d "$1" ]] || return 0
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1:$PATH" ;;
  esac
}

# Undo mise activation inherited from a parent shell. The lazy wrappers call
# `mise x` explicitly and do not need mise to rewrite the whole shell PATH.
if [[ -n "${MISE_SHELL:-}" ]] && command -v mise >/dev/null 2>&1; then
  eval "$(mise deactivate)"
fi

# System/Homebrew/user commands win naturally. Dotfiles shims come next, then
# mise's generic shims, so a global mise entry cannot bypass dotfiles policy.
# Remove inherited copies first so ordering and the opt-out are reliable.
PATH=":$PATH:"
PATH=${PATH//":${HOME}/.local/share/mise/shims:"/:}
PATH=${PATH//":${DOTFILES_PATH}/bin/shims:"/:}
PATH=${PATH#:}
PATH=${PATH%:}
if [[ -z "${DOTFILES_NO_SHIMS:-}" ]]; then
  PATH="$PATH:${DOTFILES_PATH}/bin/shims"
fi
PATH="$PATH:${HOME}/.local/share/mise/shims"

# Listed from lowest to highest priority because each entry is prepended.
add_path "/opt/homebrew/bin"
add_path "${HOME}/.cargo/bin"
add_path "${HOME}/.bin"
add_path "${HOME}/bin"
add_path "${DOTFILES_PATH}/bin"
add_path "${HOME}/.local/bin"
export PATH

# SSH runs Bash startup files for remote commands such as rsync. Keep those
# sessions silent so shell setup output cannot corrupt command protocols.
[[ $- != *i* ]] && return 0

dotfiles-update() {
  command apply "$@"
}

if [[ -n "${ZSH_VERSION:-}" ]]; then
  export SHELL_ENV=zsh
else
  export SHELL_ENV=bash
fi

source "$DOTFILES_PATH/src/std.sh"

# Keep dumb terminals limited to paths, Mise, and safe deletion.
# Local overrides are sourced by "$HOME/.${SHELL_ENV}rc" itself, after this
# file, so they arrive last and win over dotfiles settings.
if command_present "trash-put"; then
  alias rm="trash-put"
else
  require_apply_tool "trash-put"
fi
if [[ "${TERM:-}" == dumb ]]; then
  return 0
fi

source "$DOTFILES_PATH/src/history.sh"
source "$DOTFILES_PATH/src/tools.sh"

[[ "$VENDOR" != "apple" ]] || source "$DOTFILES_PATH/src/vendor.apple.sh"

export PATH

if [[ "$DOTFILES_APPLY_NEEDED" == 1 ]]; then
  printf "* run '\033[38;2;0;180;180mapply\033[0m' for new packages\n"
fi

# Return true to indicate successful sourcing of the file
return 0
