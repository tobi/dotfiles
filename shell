export EDITOR=nano
export DOTFILES_PATH="$HOME/.local/share/dotfiles"

# Global environment variables (ported from dotnix home.nix)
export DO_NOT_TRACK="1"
export OLLAMA_HOST="https://ollama.tail250b8.ts.net"
export SKILLS_DIR="$HOME/.agents/skills"
alias ls='ls --color'
alias ll='ls -lh'
alias la='ls -ah'
alias lla='ls -lah'
alias ..='cd ..'

alias e='$EDITOR'

# Aliases ported from dotnix home.nix / shell.nix
alias gs="git status"
alias sg="ast-grep"
alias t="try"
alias c="pbcopy"
alias v="pbpaste"

# Prepend deliberate user/tool paths without rebuilding the OS-provided PATH.
add_path() {
  [[ -d "$1" ]] || return 0
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1:$PATH" ;;
  esac
}

path_first() {
  local dir="$1" padded_path
  [[ -d "$dir" ]] || return 0
  padded_path=":$PATH:"
  padded_path=${padded_path//":$dir:"/:}
  padded_path=${padded_path#:}
  padded_path=${padded_path%:}
  PATH="$dir${padded_path:+:$padded_path}"
}

# Listed from lowest to highest priority because each entry is prepended.
add_path "/opt/homebrew/bin"
add_path "${HOME}/.cargo/bin"
add_path "${HOME}/.bin"
add_path "${HOME}/bin"
add_path "${DOTFILES_PATH}/bin"
add_path "${HOME}/.local/bin"
export PATH

# SSH runs Bash startup files for remote commands such as rsync. Keep those
# sessions silent so shell setup output cannot corrupt command protocols.
[[ $- != *i* ]] && return 0

apply() {
  "$DOTFILES_PATH/apply.sh" "$@"
}

dotfiles-update() {
  apply "$@"
}

source "$DOTFILES_PATH/src/std.sh"
source "$DOTFILES_PATH/src/history.sh"
source "$DOTFILES_PATH/src/mise.sh"
source "$DOTFILES_PATH/src/tools.sh"

[[ "$VENDOR" != "apple" ]] || source "$DOTFILES_PATH/src/vendor.apple.sh"

# See if we need some local overrides (.zshrc.local, .bashrc.local)
if [[ -f "$HOME/.${SHELL_ENV}rc.local" ]]; then
  source "$HOME/.${SHELL_ENV}rc.local"
fi

# Mise shims win even when local overrides prepend other toolchains.
path_first "$HOME/.local/share/mise/shims"
export PATH

if [[ "$DOTFILES_APPLY_NEEDED" == 1 ]]; then
  echo "* run '$DOTFILES_PATH/apply.sh' for new packages"
fi

# Return true to indicate successful sourcing of the file
return 0
